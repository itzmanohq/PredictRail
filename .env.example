# PredictRail Environment Configuration Example
# Copy this file to .env and adjust if needed.

# Application Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Open-Meteo Weather API (100% Free, No API Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Dataset & Model Paths
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
MODEL_DIR=./models

# RailRadar Live Train Running Status API
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in/v1
